---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page Not Found">
  <div class="mx-auto max-w-2xl px-4 py-24 text-center sm:px-6">
    <h1 class="text-3xl font-bold text-umblue-950">Page not found</h1>
    <p class="mt-4 text-slate-600">The page you're looking for doesn't exist.</p>
    <a href="/" class="mt-6 inline-block text-umblue-900 underline hover:text-umblue-950">Return home</a>
  </div>
</Layout>
