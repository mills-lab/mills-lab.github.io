---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const publications = (await getCollection('publications')).sort(
  (a, b) => Number(b.data.pmid ?? 0) - Number(a.data.pmid ?? 0)
);

function yearOf(pub: (typeof publications)[number]) {
  return pub.data.pubdate?.match(/^\d{4}/)?.[0] ?? 'Undated';
}

const years = [...new Set(publications.map(yearOf))].sort((a, b) => Number(b) - Number(a));
const groups = years.map((year) => ({
  year,
  pubs: publications.filter((pub) => yearOf(pub) === year),
}));
---

<Layout title="Publications">
  <div class="mx-auto max-w-3xl px-4 py-12 sm:px-6">
    <h1 class="text-3xl font-bold text-umblue-950">Publications</h1>

    {
      groups.map((group, i) => (
        <section>
          <h2 class:list={['text-xs font-semibold tracking-widest text-slate-400 uppercase', i === 0 ? 'mt-8' : 'mt-10']}>
            {group.year}
          </h2>
          <ul class="mt-3 space-y-6">
            {group.pubs.map((pub) => (
              <li class="flex items-start justify-between gap-3 border-b border-slate-200 pb-6 text-sm leading-relaxed text-slate-700">
                <p>
                  {pub.data.authors}. {pub.data.title}{' '}
                  <span class="font-semibold italic">{pub.data.journal}</span> {pub.data.pubdate}
                  {pub.data.volume && `, ${pub.data.volume}`}
                  {pub.data.issue && `(${pub.data.issue})`}
                  {pub.data.pages && `, ${pub.data.pages}`}
                </p>
                {pub.data.pmid && (
                  <a
                    href={`https://pubmed.ncbi.nlm.nih.gov/${pub.data.pmid}/`}
                    target="_blank"
                    rel="noopener"
                    aria-label="View on PubMed"
                    title="View on PubMed"
                    class="mt-0.5 flex-shrink-0 text-slate-400 transition hover:text-umblue-950"
                  >
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="h-5 w-5">
                      <path stroke-linecap="round" d="M7 3c0 4.5 10 4.5 10 9s-10 4.5-10 9" />
                      <path stroke-linecap="round" d="M17 3c0 4.5-10 4.5-10 9s10 4.5 10 9" />
                      <path stroke-linecap="round" d="M8 7.5h8M8 16.5h8" />
                    </svg>
                  </a>
                )}
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</Layout>
