---
import Layout from '../layouts/Layout.astro';
import FeedRow from '../components/FeedRow.astro';
import { getCollection } from 'astro:content';

const latestPosts = (await getCollection('posts'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const latestMedia = (await getCollection('media'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const people = await getCollection('people');
const currentMemberCount = people.filter((p) => p.data.publish && p.data.status !== 'alumni').length;
const publicationCount = (await getCollection('publications')).length;
const softwareCount = (await getCollection('software')).length;

const dateFmt = new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<Layout title="Home">
  <section class="bg-umblue-950 text-white">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 sm:py-16">
      <p class="text-sm font-semibold tracking-widest text-maize-400 uppercase">
        <a href="https://umich.edu" target="_blank" rel="noopener">University of Michigan</a>
        <span aria-hidden="true">&middot;</span>
        <a href="https://medicine.umich.edu/dept/computational-medicine-bioinformatics" target="_blank" rel="noopener">
          Computational Medicine &amp; Bioinformatics
        </a>
      </p>
      <h1 class="mt-3 max-w-2xl text-5xl font-bold tracking-tight sm:text-6xl">The Mills Lab</h1>
      <p class="mt-5 max-w-2xl text-lg text-slate-200">
        A bioinformatics research group developing methods to discover and characterize genomic
        structural variation in human health and disease.
      </p>
      <div class="mt-8 flex flex-wrap gap-4">
        <a href="/research/" class="rounded-md bg-maize-400 px-5 py-2.5 font-semibold text-umblue-950 hover:bg-maize-300">
          Our Research
        </a>
        <a href="/people/" class="rounded-md border border-white/40 px-5 py-2.5 font-semibold hover:bg-white/10">
          Meet the Lab
        </a>
      </div>
      <dl class="mt-10 grid max-w-xl grid-cols-2 gap-8 border-t border-white/20 pt-6 sm:grid-cols-3">
        <div>
          <dt class="text-sm text-slate-300">Lab Members</dt>
          <dd class="text-3xl font-bold text-maize-400">{currentMemberCount}</dd>
        </div>
        <div>
          <dt class="text-sm text-slate-300">Publications</dt>
          <dd class="text-3xl font-bold text-maize-400">{publicationCount}+</dd>
        </div>
        <div class="hidden sm:block">
          <dt class="text-sm text-slate-300">Software Tools</dt>
          <dd class="text-3xl font-bold text-maize-400">{softwareCount}</dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-4 py-10 sm:px-6 sm:py-12">
    <div class="flex items-baseline justify-between">
      <h2 class="text-2xl font-bold text-umblue-950">Recent Research</h2>
      <a href="/publications/" class="text-sm font-medium text-umblue-900 underline hover:text-umblue-950">
        View all publications
      </a>
    </div>
    <div class="mt-2">
      {
        latestMedia.map((item) => (
          <FeedRow
            href={item.data.url}
            external
            eyebrow={`${item.data.source} · ${dateFmt.format(item.data.date)}`}
            title={item.data.title}
            excerpt={item.data.excerpt}
            badge={item.data.source}
          />
        ))
      }
    </div>
  </section>

  <section class="bg-slate-50">
    <div class="mx-auto max-w-4xl px-4 py-10 sm:px-6 sm:py-12">
      <div class="flex items-baseline justify-between">
        <h2 class="text-2xl font-bold text-umblue-950">Lab News</h2>
        <a href="/news/" class="text-sm font-medium text-umblue-900 underline hover:text-umblue-950">View all</a>
      </div>
      <div class="mt-2">
        {
          latestPosts.map((post) => {
            const href = post.data.externalUrl || `/news/${post.id}/`;
            const teaser = post.data.image?.teaser ? `/images/${post.data.image.teaser}` : null;
            return (
              <FeedRow
                href={href}
                external={Boolean(post.data.externalUrl)}
                eyebrow={dateFmt.format(post.data.date)}
                title={post.data.title}
                imageSrc={teaser}
              />
            );
          })
        }
      </div>
    </div>
  </section>
</Layout>
