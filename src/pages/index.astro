---
import Layout from '../layouts/Layout.astro';
import FeedRow from '../components/FeedRow.astro';
import { getCollection } from 'astro:content';

// timeZone: 'UTC' is required - dates parse as UTC midnight (z.coerce.date()
// on a bare "YYYY-MM-DD"), so formatting in the server's local timezone can
// shift the displayed calendar date back a day.
const dateFmt = new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });

const newsItems = (await getCollection('posts')).map((post) => ({
  date: post.data.date,
  href: post.data.externalUrl || `/news/${post.id}/`,
  external: Boolean(post.data.externalUrl),
  eyebrow: dateFmt.format(post.data.date),
  title: post.data.title,
  excerpt: undefined as string | undefined,
  imageSrc: post.data.image?.teaser ? `/images/${post.data.image.teaser}` : null,
  badge: null as string | null,
}));

const pressItems = (await getCollection('research')).map((item) => ({
  date: item.data.date,
  href: item.data.url,
  external: true,
  eyebrow: `${item.data.source} · ${dateFmt.format(item.data.date)}`,
  title: item.data.title,
  excerpt: item.data.excerpt,
  imageSrc: item.data.image ? `/images/research/${item.data.image}` : null,
  badge: item.data.source as string | null,
}));

const recentNews = [...newsItems, ...pressItems]
  .sort((a, b) => b.date.valueOf() - a.date.valueOf())
  .slice(0, 5);
---

<Layout title="Home">
  <section class="bg-umblue-950 text-white">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 sm:py-16">
      <p class="text-sm font-semibold tracking-widest text-maize-400 uppercase">
        <a href="https://umich.edu" target="_blank" rel="noopener">University of Michigan</a>{' '}
        <span aria-hidden="true">&middot;</span>{' '}
        <a href="https://medicine.umich.edu/dept/computational-medicine-bioinformatics" target="_blank" rel="noopener">
          Gilbert S. Omenn Department of Computational Medicine &amp; Bioinformatics
        </a>
      </p>
      <h1 class="mt-3 max-w-2xl text-5xl font-bold tracking-tight sm:text-6xl">The Mills Lab</h1>
      <p class="mt-5 max-w-2xl text-lg text-slate-200">
        A bioinformatics research group exploring genomic structural variation in human health
        and disease.
      </p>
      <div class="mt-8 flex flex-wrap gap-4">
        <a href="/research/" class="rounded-md bg-maize-400 px-5 py-2.5 font-semibold text-umblue-950 hover:bg-maize-300">
          Our Research
        </a>
        <a href="/people/" class="rounded-md bg-maize-400 px-5 py-2.5 font-semibold text-umblue-950 hover:bg-maize-300">
          Meet the Lab
        </a>
        <a href="/people/ryan-mills/" class="rounded-md bg-maize-400 px-5 py-2.5 font-semibold text-umblue-950 hover:bg-maize-300">
          Meet the PI
        </a>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-8 sm:px-6 sm:py-10">
    <h2 class="text-2xl font-bold text-umblue-950">Recent News</h2>
    <div class="mt-2 max-w-4xl">
      {
        recentNews.map((item) => (
          <FeedRow
            href={item.href}
            external={item.external}
            eyebrow={item.eyebrow}
            title={item.title}
            excerpt={item.excerpt}
            imageSrc={item.imageSrc}
            badge={item.badge}
          />
        ))
      }
    </div>
  </section>
</Layout>
