---
import type { CollectionEntry } from 'astro:content';

interface Props {
  person: CollectionEntry<'people'>['data'];
}

const { person } = Astro.props;
const picture = person.picture ? `/assets/people/${person.picture}` : '/assets/people/placeholder.png';
---

<article class="flex flex-col overflow-hidden rounded-lg border border-slate-200 bg-white shadow-sm">
  <img src={picture} alt={person.name} class="h-60 w-full object-cover" loading="lazy" />
  <div class="flex flex-1 flex-col gap-1 p-4">
    <h3 class="font-semibold text-umblue-950">{person.name}</h3>
    {person.title && <p class="text-sm text-slate-600">{person.title}</p>}
    <ul class="mt-1 space-y-0.5 text-sm text-slate-500">
      {person.line1 && <li set:html={person.line1} />}
      {person.line2 && <li set:html={person.line2} />}
      {person.line3 && <li set:html={person.line3} />}
    </ul>
    {
      (person.cv || person.googleScholar || person.email) && (
        <div class="mt-3 flex flex-wrap gap-x-3 gap-y-1 text-sm">
          {person.cv && (
            <a href={`/assets/${person.cv}`} target="_blank" class="text-umblue-900 underline hover:text-umblue-950">
              CV
            </a>
          )}
          {person.googleScholar && (
            <a
              href={`https://scholar.google.com/citations?user=${person.googleScholar}`}
              target="_blank"
              class="text-umblue-900 underline hover:text-umblue-950"
            >
              Google Scholar
            </a>
          )}
          {person.email && (
            <a href={`mailto:${person.email}`} class="text-umblue-900 underline hover:text-umblue-950">
              Email
            </a>
          )}
        </div>
      )
    }
  </div>
</article>
