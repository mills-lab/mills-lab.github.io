---
import fs from 'node:fs';
import path from 'node:path';

interface Props {
  folder: string;
}

const { folder } = Astro.props;
const IMAGE_EXT = /\.(jpe?g|png|gif|webp)$/i;

const dir = path.join(process.cwd(), 'public/images', folder);
const images = fs.existsSync(dir)
  ? fs.readdirSync(dir).filter((f) => IMAGE_EXT.test(f)).sort()
  : [];
---

{
  images.length > 0 && (
    <div class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-3">
      {images.map((image) => (
        <button
          type="button"
          data-lightbox-src={`/images/${folder}/${image}`}
          class="block cursor-zoom-in appearance-none border-0 bg-transparent p-0"
          aria-label="View full-size photo"
        >
          <img
            src={`/images/${folder}/${image}`}
            alt=""
            loading="lazy"
            class="aspect-square w-full rounded-md object-cover transition hover:opacity-90"
          />
        </button>
      ))}
    </div>
  )
}
