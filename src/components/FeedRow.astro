---
interface Props {
  href: string;
  external?: boolean;
  eyebrow: string;
  title: string;
  excerpt?: string;
  imageSrc?: string | null;
  badge?: string | null;
}

const { href, external = false, eyebrow, title, excerpt, imageSrc = null, badge = null } = Astro.props;
---

<a
  href={href}
  target={external ? '_blank' : undefined}
  class="group flex flex-col gap-5 border-b border-slate-200 py-7 first:pt-0 last:border-0 sm:flex-row sm:items-center"
>
  {
    imageSrc ? (
      <img
        src={imageSrc}
        alt=""
        loading="lazy"
        class="h-44 w-full flex-shrink-0 rounded-lg object-cover sm:h-32 sm:w-52"
      />
    ) : (
      badge && (
        <div class="flex h-44 w-full flex-shrink-0 items-center justify-center rounded-lg bg-umblue-950 px-4 text-center text-sm font-semibold text-maize-400 sm:h-32 sm:w-52">
          {badge}
        </div>
      )
    )
  }
  <div class="min-w-0 flex-1">
    <p class="text-xs font-medium tracking-wide text-slate-500 uppercase">{eyebrow}</p>
    <h3 class="mt-1 text-xl font-semibold text-umblue-950 group-hover:underline">{title}</h3>
    {excerpt && <p class="mt-2 text-slate-600">{excerpt}</p>}
  </div>
</a>
