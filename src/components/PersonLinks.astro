---
// Renders a person's external links (CV, Google Scholar, LinkedIn, GitHub,
// email, ...) as icon-only buttons. The `type` enum plus an `other` +
// custom `label` escape hatch is what makes this extensible: Phase 3's CMS
// should expose "other" as an "add a different kind of link" option so
// lab members aren't limited to this preset list.
type LinkType = 'cv' | 'googleScholar' | 'linkedin' | 'github' | 'twitter' | 'website' | 'email' | 'other';

interface LinkItem {
  type: LinkType;
  label?: string;
  url: string;
}

interface Props {
  links: LinkItem[];
}

const { links } = Astro.props;

const ORDER: LinkType[] = ['cv', 'googleScholar', 'linkedin', 'github', 'website', 'twitter', 'email', 'other'];
const DEFAULT_LABEL: Record<LinkType, string> = {
  cv: 'CV',
  googleScholar: 'Google Scholar',
  linkedin: 'LinkedIn',
  github: 'GitHub',
  twitter: 'X (Twitter)',
  website: 'Website',
  email: 'Email',
  other: 'Link',
};

const sorted = [...links].sort((a, b) => ORDER.indexOf(a.type) - ORDER.indexOf(b.type));

function hrefFor(link: LinkItem) {
  return link.type === 'email' ? `mailto:${link.url}` : link.url;
}
---

{
  sorted.length > 0 && (
    <div class="mt-3 flex flex-wrap gap-2">
      {sorted.map((link) => {
        const label = link.label || DEFAULT_LABEL[link.type];
        const external = link.type !== 'email';
        return (
          <a
            href={hrefFor(link)}
            target={external ? '_blank' : undefined}
            rel={external ? 'noopener' : undefined}
            aria-label={label}
            title={label}
            class="flex h-8 w-8 items-center justify-center rounded-full bg-slate-100 text-slate-600 transition hover:bg-umblue-950 hover:text-white"
          >
            {link.type === 'cv' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="h-4 w-4">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M7 21h10a2 2 0 0 0 2-2V7.83a2 2 0 0 0-.59-1.42l-3.82-3.82A2 2 0 0 0 13.17 2H7a2 2 0 0 0-2 2v15a2 2 0 0 0 2 2Z"
                />
                <path stroke-linecap="round" stroke-linejoin="round" d="M13 2v4a2 2 0 0 0 2 2h4M9 13h6M9 17h6" />
              </svg>
            )}
            {link.type === 'googleScholar' && (
              <svg viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4">
                <path d="M12 3 1 8.5 12 14l9-4.5V15h1.5V8.5L12 3Z" />
                <path d="M5.5 10.7v4.1c0 1.66 2.91 3.2 6.5 3.2s6.5-1.54 6.5-3.2v-4.1L12 15.2l-6.5-4.5Z" />
              </svg>
            )}
            {link.type === 'linkedin' && (
              <svg viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4">
                <path d="M6.94 8.5H3.56V20h3.38V8.5ZM5.25 3a1.96 1.96 0 1 0 0 3.92A1.96 1.96 0 0 0 5.25 3ZM20.45 20h-3.37v-5.6c0-1.34-.02-3.06-1.87-3.06-1.87 0-2.16 1.46-2.16 2.96V20H9.68V8.5h3.24v1.57h.05c.45-.85 1.56-1.75 3.21-1.75 3.43 0 4.27 2.26 4.27 5.19V20Z" />
              </svg>
            )}
            {link.type === 'github' && (
              <svg viewBox="0 0 16 16" fill="currentColor" class="h-4 w-4">
                <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
              </svg>
            )}
            {link.type === 'website' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="h-4 w-4">
                <circle cx="12" cy="12" r="9" />
                <path
                  stroke-linecap="round"
                  d="M3 12h18M12 3c2.5 2.7 3.8 6 3.8 9s-1.3 6.3-3.8 9c-2.5-2.7-3.8-6-3.8-9s1.3-6.3 3.8-9Z"
                />
              </svg>
            )}
            {link.type === 'twitter' && (
              <svg viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4">
                <path d="M18.244 2H21l-6.5 7.43L22 22h-6.34l-4.96-6.5L4.9 22H2.14l7-8-7.14-9.72H8.5l4.49 5.94L18.24 2Zm-1.11 18h1.86L7.2 3.9H5.2l11.93 16.1Z" />
              </svg>
            )}
            {link.type === 'email' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="h-4 w-4">
                <rect x="3" y="5" width="18" height="14" rx="2" />
                <path stroke-linecap="round" stroke-linejoin="round" d="m3.5 6 8.5 7 8.5-7" />
              </svg>
            )}
            {link.type === 'other' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="h-4 w-4">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M9.5 14.5 14.5 9.5M8 14 5.5 16.5a3 3 0 1 0 4 4L12 18M16 10l2.5-2.5a3 3 0 1 0-4-4L12 6"
                />
              </svg>
            )}
          </a>
        );
      })}
    </div>
  )
}
